// India EV Market Study - DAX measures
// Generated by scripts/build_powerbi.py. In Power BI: select the table named in the
// header, Modeling > New measure, paste one block at a time.

// ===== Table: fact_state_sales =====

// Format: #,0   Folder: 1 Volume
EV Sold =
    SUM ( fact_state_sales[electric_vehicles_sold] )

// Format: #,0   Folder: 1 Volume
Total Vehicles Sold =
    SUM ( fact_state_sales[total_vehicles_sold] )

// Format: #,0   Folder: 1 Volume
Non-EV Sold =
    SUM ( fact_state_sales[non_ev_sold] )

// Format: 0.00%   Folder: 2 Penetration
EV Penetration % =
    DIVIDE ( [EV Sold], [Total Vehicles Sold] )

// Format: #,0   Folder: 1 Volume
EV Sold FY2022 =
    CALCULATE ( [EV Sold], dim_date[fiscal_year] = 2022 )

// Format: #,0   Folder: 1 Volume
EV Sold FY2023 =
    CALCULATE ( [EV Sold], dim_date[fiscal_year] = 2023 )

// Format: #,0   Folder: 1 Volume
EV Sold FY2024 =
    CALCULATE ( [EV Sold], dim_date[fiscal_year] = 2024 )

// Format: #,0   Folder: 1 Volume
Total Vehicles FY2022 =
    CALCULATE ( [Total Vehicles Sold], dim_date[fiscal_year] = 2022 )

// Format: #,0   Folder: 1 Volume
Total Vehicles FY2024 =
    CALCULATE ( [Total Vehicles Sold], dim_date[fiscal_year] = 2024 )

// Format: 0.00%   Folder: 2 Penetration
Penetration FY2022 =
    CALCULATE ( [EV Penetration %], dim_date[fiscal_year] = 2022 )

// Format: 0.00%   Folder: 2 Penetration
Penetration FY2023 =
    CALCULATE ( [EV Penetration %], dim_date[fiscal_year] = 2023 )

// Format: 0.00%   Folder: 2 Penetration
Penetration FY2024 =
    CALCULATE ( [EV Penetration %], dim_date[fiscal_year] = 2024 )

// Format: +0.00%;-0.00%;0.00%   Folder: 2 Penetration
Penetration Change FY22-24 =
    IF ( NOT ISBLANK ( [Penetration FY2022] ), [Penetration FY2024] - [Penetration FY2022] )

// Format: 0   Folder: 2 Penetration
Penetration Declined FY22-24 Flag =
    IF ( [Penetration Change FY22-24] < 0, 1, 0 )

// Format: 0.0%   Folder: 3 Growth
EV CAGR FY22-24 =
    IF ( [EV Sold FY2022] > 0, ( [EV Sold FY2024] / [EV Sold FY2022] ) ^ ( 1 / 2 ) - 1 )

// Format: 0.0%   Folder: 3 Growth
Total Vehicles CAGR FY22-24 =
    IF ( [Total Vehicles FY2022] > 0, ( [Total Vehicles FY2024] / [Total Vehicles FY2022] ) ^ ( 1 / 2 ) - 1 )

// Format: #,0   Folder: 3 Growth
Projected EV Sales FY2030 =
    IF ( NOT ISBLANK ( [EV CAGR FY22-24] ), [EV Sold FY2024] * ( 1 + [EV CAGR FY22-24] ) ^ 6 )

// Format: 0.0%   Folder: 3 Growth
EV Sold YoY % =
    VAR fy = MAX ( dim_date[fiscal_year] )
    VAR prev = CALCULATE ( [EV Sold], REMOVEFILTERS ( dim_date[fy_label] ), dim_date[fiscal_year] = fy - 1 )
    RETURN IF ( prev > 0, DIVIDE ( [EV Sold], prev ) - 1 )

// Format: 0.0%   Folder: 3 Growth
EV Share of 3-Year Sales % =
    DIVIDE ( [EV Sold], CALCULATE ( [EV Sold], REMOVEFILTERS ( dim_date ) ) )

// Format: #,0   Folder: 4 Revenue
EV Revenue (INR) =
    SUMX ( dim_vehicle_category, [EV Sold] * dim_vehicle_category[avg_unit_price_inr] )

// Format: #,0   Folder: 4 Revenue
EV Revenue (Rs Cr) =
    DIVIDE ( [EV Revenue (INR)], 10000000 )

// Format: #,0   Folder: 4 Revenue
Revenue FY2022 (Rs Cr) =
    CALCULATE ( [EV Revenue (Rs Cr)], dim_date[fiscal_year] = 2022 )

// Format: #,0   Folder: 4 Revenue
Revenue FY2023 (Rs Cr) =
    CALCULATE ( [EV Revenue (Rs Cr)], dim_date[fiscal_year] = 2023 )

// Format: #,0   Folder: 4 Revenue
Revenue FY2024 (Rs Cr) =
    CALCULATE ( [EV Revenue (Rs Cr)], dim_date[fiscal_year] = 2024 )

// Format: 0.0%   Folder: 4 Revenue
Revenue Growth FY22-24 =
    DIVIDE ( [Revenue FY2024 (Rs Cr)], [Revenue FY2022 (Rs Cr)] ) - 1

// Format: 0.0%   Folder: 4 Revenue
Revenue Growth FY23-24 =
    DIVIDE ( [Revenue FY2024 (Rs Cr)], [Revenue FY2023 (Rs Cr)] ) - 1

// Format: 0.00%   Folder: 6 Dashboard
2W Penetration FY2024 =
    CALCULATE ( [EV Penetration %], dim_date[fiscal_year] = 2024, dim_vehicle_category[vehicle_category] = "2-Wheelers" )

// Format: 0.00%   Folder: 6 Dashboard
4W Penetration FY2024 =
    CALCULATE ( [EV Penetration %], dim_date[fiscal_year] = 2024, dim_vehicle_category[vehicle_category] = "4-Wheelers" )

// Format: 0.00%   Folder: 6 Dashboard
Q2 Top 5 States 2W Penetration FY2024 =
    VAR v = [2W Penetration FY2024]
    VAR r = RANKX ( ALL ( dim_state[state] ), [2W Penetration FY2024], , DESC )
    RETURN IF ( NOT ISBLANK ( v ) && r <= 5, v )

// Format: 0.00%   Folder: 6 Dashboard
Q2 Top 5 States 4W Penetration FY2024 =
    VAR v = [4W Penetration FY2024]
    VAR r = RANKX ( ALL ( dim_state[state] ), [4W Penetration FY2024], , DESC )
    RETURN IF ( NOT ISBLANK ( v ) && r <= 5, v )

// Format: 0.00%   Folder: 6 Dashboard
Q3 Declined Penetration FY2022 =
    IF ( [Penetration Change FY22-24] < 0, [Penetration FY2022] )

// Format: 0.00%   Folder: 6 Dashboard
Q3 Declined Penetration FY2024 =
    IF ( [Penetration Change FY22-24] < 0, [Penetration FY2024] )

// Format: +0.00%;-0.00%;0.00%   Folder: 6 Dashboard
Q3 Declined Change =
    IF ( [Penetration Change FY22-24] < 0, [Penetration Change FY22-24] )

// Format: #,0   Folder: 6 Dashboard
Q5 EV Sold FY2024 (Delhi, Karnataka) =
    CALCULATE ( [EV Sold FY2024], KEEPFILTERS ( dim_state[state] IN { "Delhi", "Karnataka" } ) )

// Format: 0.00%   Folder: 6 Dashboard
Q5 Penetration FY2024 (Delhi, Karnataka) =
    CALCULATE ( [Penetration FY2024], KEEPFILTERS ( dim_state[state] IN { "Delhi", "Karnataka" } ) )

// Format: 0.0%   Folder: 6 Dashboard
Q7 Top 10 States Total Vehicles CAGR =
    VAR v = [Total Vehicles CAGR FY22-24]
    VAR r = RANKX ( ALL ( dim_state[state] ), [Total Vehicles CAGR FY22-24], , DESC )
    RETURN IF ( NOT ISBLANK ( v ) && r <= 10, v )

// Format: 0   Folder: 6 Dashboard
Top 10 Penetration Rank FY2024 =
    RANKX ( ALL ( dim_state[state] ), [Penetration FY2024], , DESC )

// Format: 0.00%   Folder: 6 Dashboard
Q9 Penetration FY2024 (Top 10) =
    IF ( HASONEVALUE ( dim_state[state] ) && [Top 10 Penetration Rank FY2024] <= 10, [Penetration FY2024] )

// Format: 0.0%   Folder: 6 Dashboard
Q9 EV CAGR FY22-24 (Top 10) =
    IF ( HASONEVALUE ( dim_state[state] ) && [Top 10 Penetration Rank FY2024] <= 10, [EV CAGR FY22-24] )

// Format: #,0   Folder: 6 Dashboard
Q9 Projected EV Sales FY2030 (Top 10) =
    IF ( HASONEVALUE ( dim_state[state] ) && [Top 10 Penetration Rank FY2024] <= 10, [Projected EV Sales FY2030] )

// ===== Table: fact_maker_sales =====

// Format: #,0   Folder: 5 Makers
Maker EV Sold =
    SUM ( fact_maker_sales[electric_vehicles_sold] )

// Format: #,0   Folder: 5 Makers
Maker EV Sold FY2022 =
    CALCULATE ( [Maker EV Sold], dim_date[fiscal_year] = 2022 )

// Format: #,0   Folder: 5 Makers
Maker EV Sold FY2023 =
    CALCULATE ( [Maker EV Sold], dim_date[fiscal_year] = 2023 )

// Format: #,0   Folder: 5 Makers
Maker EV Sold FY2024 =
    CALCULATE ( [Maker EV Sold], dim_date[fiscal_year] = 2024 )

// Format: 0.0%   Folder: 5 Makers
Maker CAGR FY22-24 =
    IF ( [Maker EV Sold FY2022] > 0, ( [Maker EV Sold FY2024] / [Maker EV Sold FY2022] ) ^ ( 1 / 2 ) - 1 )

// Format: 0.0%   Folder: 5 Makers
Maker Market Share % =
    DIVIDE ( [Maker EV Sold], CALCULATE ( [Maker EV Sold], REMOVEFILTERS ( dim_maker ) ) )

// Format: #,0   Folder: 6 Dashboard
2W Maker Sales FY2023 =
    CALCULATE ( [Maker EV Sold], dim_date[fiscal_year] = 2023, dim_vehicle_category[vehicle_category] = "2-Wheelers", KEEPFILTERS ( dim_maker[maker] <> "Others" ) )

// Format: #,0   Folder: 6 Dashboard
2W Maker Sales FY2024 =
    CALCULATE ( [Maker EV Sold], dim_date[fiscal_year] = 2024, dim_vehicle_category[vehicle_category] = "2-Wheelers", KEEPFILTERS ( dim_maker[maker] <> "Others" ) )

// Format: #,0   Folder: 6 Dashboard
Q1 Top 3 2W Makers FY2023 =
    VAR v = [2W Maker Sales FY2023]
    VAR r = RANKX ( FILTER ( ALL ( dim_maker[maker] ), [2W Maker Sales FY2023] > 0 ), [2W Maker Sales FY2023], , DESC )
    RETURN IF ( v > 0 && r <= 3, v )

// Format: #,0   Folder: 6 Dashboard
Q1 Bottom 3 2W Makers FY2023 =
    VAR v = [2W Maker Sales FY2023]
    VAR r = RANKX ( FILTER ( ALL ( dim_maker[maker] ), [2W Maker Sales FY2023] > 0 ), [2W Maker Sales FY2023], , ASC )
    RETURN IF ( v > 0 && r <= 3, v )

// Format: #,0   Folder: 6 Dashboard
Q1 Top 3 2W Makers FY2024 =
    VAR v = [2W Maker Sales FY2024]
    VAR r = RANKX ( FILTER ( ALL ( dim_maker[maker] ), [2W Maker Sales FY2024] > 0 ), [2W Maker Sales FY2024], , DESC )
    RETURN IF ( v > 0 && r <= 3, v )

// Format: #,0   Folder: 6 Dashboard
Q1 Bottom 3 2W Makers FY2024 =
    VAR v = [2W Maker Sales FY2024]
    VAR r = RANKX ( FILTER ( ALL ( dim_maker[maker] ), [2W Maker Sales FY2024] > 0 ), [2W Maker Sales FY2024], , ASC )
    RETURN IF ( v > 0 && r <= 3, v )

// Format: #,0   Folder: 6 Dashboard
4W Maker Sales All Years =
    CALCULATE ( [Maker EV Sold], REMOVEFILTERS ( dim_date ), dim_vehicle_category[vehicle_category] = "4-Wheelers" )

// Format: #,0   Folder: 6 Dashboard
Q4 Top 5 4W Makers Sales =
    VAR r = RANKX ( FILTER ( ALL ( dim_maker[maker] ), [4W Maker Sales All Years] > 0 ), [4W Maker Sales All Years], , DESC )
    VAR keep = HASONEVALUE ( dim_maker[maker] ) && [4W Maker Sales All Years] > 0 && r <= 5
    RETURN IF ( keep, CALCULATE ( [Maker EV Sold], dim_vehicle_category[vehicle_category] = "4-Wheelers" ) )

// Format: 0.0%   Folder: 6 Dashboard
Q6 Top 5 4W Makers CAGR FY22-24 =
    VAR r = RANKX ( FILTER ( ALL ( dim_maker[maker] ), [4W Maker Sales All Years] > 0 ), [4W Maker Sales All Years], , DESC )
    VAR keep = HASONEVALUE ( dim_maker[maker] ) && [4W Maker Sales All Years] > 0 && r <= 5
    RETURN IF ( keep, [Maker CAGR FY22-24] )

// Format: #,0   Folder: 6 Dashboard
Q6 Top 5 4W Makers Units FY2022 =
    VAR r = RANKX ( FILTER ( ALL ( dim_maker[maker] ), [4W Maker Sales All Years] > 0 ), [4W Maker Sales All Years], , DESC )
    VAR keep = HASONEVALUE ( dim_maker[maker] ) && [4W Maker Sales All Years] > 0 && r <= 5
    RETURN IF ( keep, [Maker EV Sold FY2022] )

// Format: #,0   Folder: 6 Dashboard
Q6 Top 5 4W Makers Units FY2024 =
    VAR r = RANKX ( FILTER ( ALL ( dim_maker[maker] ), [4W Maker Sales All Years] > 0 ), [4W Maker Sales All Years], , DESC )
    VAR keep = HASONEVALUE ( dim_maker[maker] ) && [4W Maker Sales All Years] > 0 && r <= 5
    RETURN IF ( keep, [Maker EV Sold FY2024] )
