// India EV Market Study - DAX measures
// Generated by scripts/build_powerbi.py. In Power BI: select the table named in the
// header, Modeling > New measure, paste one block at a time.

// ===== Table: fact_state_sales =====

// Format: #,0   Folder: 1 Volume
EV Sold =
    SUM ( fact_state_sales[electric_vehicles_sold] )

// Format: #,0   Folder: 1 Volume
Total Vehicles Sold =
    SUM ( fact_state_sales[total_vehicles_sold] )

// Format: #,0   Folder: 1 Volume
Non-EV Sold =
    SUM ( fact_state_sales[non_ev_sold] )

// Format: 0.00%   Folder: 2 Penetration
EV Penetration % =
    DIVIDE ( [EV Sold], [Total Vehicles Sold] )

// Format: #,0   Folder: 1 Volume
EV Sold FY2022 =
    CALCULATE ( [EV Sold], dim_date[fiscal_year] = 2022 )

// Format: #,0   Folder: 1 Volume
EV Sold FY2023 =
    CALCULATE ( [EV Sold], dim_date[fiscal_year] = 2023 )

// Format: #,0   Folder: 1 Volume
EV Sold FY2024 =
    CALCULATE ( [EV Sold], dim_date[fiscal_year] = 2024 )

// Format: #,0   Folder: 1 Volume
Total Vehicles FY2022 =
    CALCULATE ( [Total Vehicles Sold], dim_date[fiscal_year] = 2022 )

// Format: #,0   Folder: 1 Volume
Total Vehicles FY2024 =
    CALCULATE ( [Total Vehicles Sold], dim_date[fiscal_year] = 2024 )

// Format: 0.00%   Folder: 2 Penetration
Penetration FY2022 =
    CALCULATE ( [EV Penetration %], dim_date[fiscal_year] = 2022 )

// Format: 0.00%   Folder: 2 Penetration
Penetration FY2023 =
    CALCULATE ( [EV Penetration %], dim_date[fiscal_year] = 2023 )

// Format: 0.00%   Folder: 2 Penetration
Penetration FY2024 =
    CALCULATE ( [EV Penetration %], dim_date[fiscal_year] = 2024 )

// Format: +0.00%;-0.00%;0.00%   Folder: 2 Penetration
Penetration Change FY22-24 =
    IF ( NOT ISBLANK ( [Penetration FY2022] ), [Penetration FY2024] - [Penetration FY2022] )

// Format: 0   Folder: 2 Penetration
Penetration Declined FY22-24 Flag =
    IF ( [Penetration Change FY22-24] < 0, 1, 0 )

// Format: 0.0%   Folder: 3 Growth
EV CAGR FY22-24 =
    IF ( [EV Sold FY2022] > 0, ( [EV Sold FY2024] / [EV Sold FY2022] ) ^ ( 1 / 2 ) - 1 )

// Format: 0.0%   Folder: 3 Growth
Total Vehicles CAGR FY22-24 =
    IF ( [Total Vehicles FY2022] > 0, ( [Total Vehicles FY2024] / [Total Vehicles FY2022] ) ^ ( 1 / 2 ) - 1 )

// Format: #,0   Folder: 3 Growth
Projected EV Sales FY2030 =
    IF ( NOT ISBLANK ( [EV CAGR FY22-24] ), [EV Sold FY2024] * ( 1 + [EV CAGR FY22-24] ) ^ 6 )

// Format: 0.0%   Folder: 3 Growth
EV Sold YoY % =
    VAR fy = MAX ( dim_date[fiscal_year] )
    VAR prev = CALCULATE ( [EV Sold], REMOVEFILTERS ( dim_date[fy_label] ), dim_date[fiscal_year] = fy - 1 )
    RETURN IF ( prev > 0, DIVIDE ( [EV Sold], prev ) - 1 )

// Format: 0.0%   Folder: 3 Growth
EV Share of 3-Year Sales % =
    DIVIDE ( [EV Sold], CALCULATE ( [EV Sold], REMOVEFILTERS ( dim_date ) ) )

// Format: #,0   Folder: 4 Revenue
EV Revenue (INR) =
    SUMX ( dim_vehicle_category, [EV Sold] * dim_vehicle_category[avg_unit_price_inr] )

// Format: #,0   Folder: 4 Revenue
EV Revenue (Rs Cr) =
    DIVIDE ( [EV Revenue (INR)], 10000000 )

// Format: #,0   Folder: 4 Revenue
Revenue FY2022 (Rs Cr) =
    CALCULATE ( [EV Revenue (Rs Cr)], dim_date[fiscal_year] = 2022 )

// Format: #,0   Folder: 4 Revenue
Revenue FY2023 (Rs Cr) =
    CALCULATE ( [EV Revenue (Rs Cr)], dim_date[fiscal_year] = 2023 )

// Format: #,0   Folder: 4 Revenue
Revenue FY2024 (Rs Cr) =
    CALCULATE ( [EV Revenue (Rs Cr)], dim_date[fiscal_year] = 2024 )

// Format: 0.0%   Folder: 4 Revenue
Revenue Growth FY22-24 =
    DIVIDE ( [Revenue FY2024 (Rs Cr)], [Revenue FY2022 (Rs Cr)] ) - 1

// Format: 0.0%   Folder: 4 Revenue
Revenue Growth FY23-24 =
    DIVIDE ( [Revenue FY2024 (Rs Cr)], [Revenue FY2023 (Rs Cr)] ) - 1

// ===== Table: fact_maker_sales =====

// Format: #,0   Folder: 5 Makers
Maker EV Sold =
    SUM ( fact_maker_sales[electric_vehicles_sold] )

// Format: #,0   Folder: 5 Makers
Maker EV Sold FY2022 =
    CALCULATE ( [Maker EV Sold], dim_date[fiscal_year] = 2022 )

// Format: #,0   Folder: 5 Makers
Maker EV Sold FY2023 =
    CALCULATE ( [Maker EV Sold], dim_date[fiscal_year] = 2023 )

// Format: #,0   Folder: 5 Makers
Maker EV Sold FY2024 =
    CALCULATE ( [Maker EV Sold], dim_date[fiscal_year] = 2024 )

// Format: 0.0%   Folder: 5 Makers
Maker CAGR FY22-24 =
    IF ( [Maker EV Sold FY2022] > 0, ( [Maker EV Sold FY2024] / [Maker EV Sold FY2022] ) ^ ( 1 / 2 ) - 1 )

// Format: 0.0%   Folder: 5 Makers
Maker Market Share % =
    DIVIDE ( [Maker EV Sold], CALCULATE ( [Maker EV Sold], REMOVEFILTERS ( dim_maker ) ) )
